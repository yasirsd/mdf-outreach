# MDF Outreach — required environment.
#
# Supabase (from https://app.supabase.com → Project Settings → API):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# MDF application-session HMAC secret. Must be at least 32 chars.
# Generate a new value for each environment with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# NEVER commit this file. Never expose this via NEXT_PUBLIC_*.
APP_SESSION_SECRET=

# Storage mode used by the app.
#   cloud = read/write from Supabase (production)
#   local = read/write from the browser's IndexedDB (development only)
NEXT_PUBLIC_MDF_STORAGE_MODE=cloud

# --- Gmail send-only (Phase D2 / D3A) ---
# From Google Cloud Console → APIs & Services → Credentials → OAuth Client.
# Server-only; NEVER prefix with NEXT_PUBLIC_.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dedicated encryption key for Gmail OAuth tokens at rest (AES-256-GCM).
# Deliberately separate from APP_SESSION_SECRET so the two can be rotated
# independently. Minimum 32 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# NEVER commit; NEVER prefix with NEXT_PUBLIC_.
GMAIL_TOKEN_ENCRYPTION_KEY=

# Absolute origin used to build the OAuth redirect_uri.
# Locally: http://localhost:3000
# Production (Vercel): the deployed origin, e.g. https://outreach.mdfexport.com
APP_BASE_URL=http://localhost:3000

# --- Buyer Finder ---
# Hunter API key enables free company discovery and masked people discovery.
# Server-only; NEVER prefix with NEXT_PUBLIC_.
BUYER_FINDER_HUNTER_API_KEY=

# Paid personal reveal (Search credits). Exact "true" only. Keep false.
BUYER_FINDER_HUNTER_REVEAL_ENABLED=false

# Gmail / campaign send. External consequence. Keep false for this phase.
BUYER_SEND_ENABLED=false

# Removed (CFG1) — ignored if still present in a local env file:
#   BUYER_FINDER_HUNTER_ENABLED
#   BUYER_FINDER_PUBLIC_WEBSITE_ENABLED
#   BUYER_FINDER_AUTO_FREE_ENRICHMENT_ENABLED
#
# Locked unused paid enrichment (Domain Search / Email Finder). Do not set true.
# BUYER_FINDER_HUNTER_ENRICHMENT_ENABLED=false


# MDF Outreach — required environment.
#
# Supabase (from https://app.supabase.com → Project Settings → API):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# MDF application-session HMAC secret. Must be at least 32 chars.
# Generate a new value for each environment with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# NEVER commit this file. Never expose this via NEXT_PUBLIC_*.
APP_SESSION_SECRET=

# Storage mode used by the app.
#   cloud = read/write from Supabase (production)
#   local = read/write from the browser's IndexedDB (development only)
NEXT_PUBLIC_MDF_STORAGE_MODE=cloud
